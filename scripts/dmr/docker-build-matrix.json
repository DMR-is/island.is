{
  "comment": "DMR judicial-system Docker build matrix. Single source of truth for CI (GitHub Actions) and the local build helper scripts/dmr/docker-build.sh. All services build from the shared multi-stage Dockerfile scripts/ci/Dockerfile; no per-service Dockerfile exists by design. Ports verified from each app's src/main.ts (2026-10-19); scheduler is a worker with no HTTP listener.",
  "dockerfile": "scripts/ci/Dockerfile",
  "node_version": "22.22.3",
  "services": [
    { "name": "api",                 "app": "judicial-system-api",                 "home": "apps/judicial-system/api",                 "target": "output-express-yarn", "port": 3333 },
    { "name": "backend",             "app": "judicial-system-backend",             "home": "apps/judicial-system/backend",             "target": "output-express-yarn", "port": 3344, "migrations": true },
    { "name": "web",                 "app": "judicial-system-web",                 "home": "apps/judicial-system/web",                 "target": "output-next",         "port": 4200 },
    { "name": "digital-mailbox-api", "app": "judicial-system-digital-mailbox-api", "home": "apps/judicial-system/digital-mailbox-api", "target": "output-express-yarn", "port": 3358 },
    { "name": "message-handler",     "app": "judicial-system-message-handler",     "home": "apps/judicial-system/message-handler",     "target": "output-express-yarn", "port": 3366 },
    { "name": "scheduler",           "app": "judicial-system-scheduler",           "home": "apps/judicial-system/scheduler",           "target": "output-express-yarn" },
    { "name": "xrd-api",             "app": "judicial-system-xrd-api",             "home": "apps/judicial-system/xrd-api",             "target": "output-express-yarn", "port": 3355 }
  ]
}
